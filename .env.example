# IC WARE HQ — Beispielkonfiguration. NIE echte Werte in diese Datei schreiben.
# Alle Werte in {GESCHWEIFTEN KLAMMERN} ersetzen. Jede Variable geht auch als ..._FILE (Secret-Datei).

ICHQ_ENV=development

# Datenbank: vier getrennte Rollen (deploy/postgres/init-roles.sql)
ICHQ_DATABASE_URL=postgresql://ichq_app:{APP_PASSWORT}@localhost:5432/ichq
ICHQ_PLATFORM_DATABASE_URL=postgresql://ichq_platform:{PLATFORM_PASSWORT}@localhost:5432/ichq
ICHQ_WORKER_DATABASE_URL=postgresql://ichq_worker:{WORKER_PASSWORT}@localhost:5432/ichq
ICHQ_AUTH_DATABASE_URL=postgresql://ichq_auth:{AUTH_PASSWORT}@localhost:5432/ichq
ICHQ_MIGRATION_DATABASE_URL=postgresql://ichq_owner:{OWNER_PASSWORT}@localhost:5432/ichq

# Mindestens 32 Zeichen, zufällig, verschieden: python -c "import secrets; print(secrets.token_urlsafe(48))"
ICHQ_SECRET_KEY={ZUFALL_48}
ICHQ_SESSION_SECRET={ANDERER_ZUFALL_48}

ICHQ_STORAGE_BACKEND=local
ICHQ_STORAGE_PATH=./var/storage
# ICHQ_STORAGE_BACKEND=s3
# ICHQ_S3_ENDPOINT_URL=http://localhost:9000
# ICHQ_S3_BUCKET=ichq
# ICHQ_S3_ACCESS_KEY={S3_ZUGANG}
# ICHQ_S3_SECRET_KEY={S3_GEHEIMNIS}

# E-Mail (in M1 noch ungenutzt)
# ICHQ_SMTP_HOST=smtp.example.org
# ICHQ_SMTP_USER=hq@ic-ware.eu
# ICHQ_SMTP_PASSWORD={SMTP_PASSWORT}
# ICHQ_SMTP_FROM=hq@ic-ware.eu

# Anmeldung (M2)
ICHQ_PUBLIC_ORIGIN=http://localhost:8000
# ICHQ_SESSION_IDLE_MINUTES=30
# ICHQ_SESSION_ABSOLUTE_HOURS=12
# ICHQ_LOGIN_MAX_FAILURES=5
# ICHQ_LOCKOUT_MINUTES=15

ICHQ_LOG_LEVEL=INFO
ICHQ_LOG_FORMAT=console
ICHQ_EXPOSE_DOCS=true

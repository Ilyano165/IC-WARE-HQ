# Reverse Proxy: TLS (automatische Zertifikate), HSTS, Größenlimit, geschwärzte Logs.
# Umgebung: ICHQ_DOMAIN (z. B. app.ic-ware.eu). Ports und Upstream nur für Tests überschreiben.
{
	http_port {$ICHQ_HTTP_PORT:80}
	https_port {$ICHQ_HTTPS_PORT:443}
	admin off
	skip_install_trust
	# Gilt für alle Logs außer dem Zugriffslog — auch Fehlerlogs enthalten die angefragte URI
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?[REDACTED]"
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

{$ICHQ_DOMAIN:localhost} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy {$ICHQ_UPSTREAM:app:8000} {
		health_uri /readiness
		health_interval 5s
		health_timeout 3s
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# komplette Query entfernen — kann Tokens enthalten
				request>uri regexp "\?.*$" "?[REDACTED]"
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}
